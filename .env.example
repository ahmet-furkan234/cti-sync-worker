NODE_ENV=development
# Same database as cti-backend (the backend owns the migrations)
DATABASE_URL=postgres://cti:cti_dev_password@localhost:5440/cti
LOG_LEVEL=info

# Optional NVD API key: 5 → 50 requests / 30 s, makes the first full load ~10x faster
NVD_API_KEY=

# false = no scheduled runs (manual "Sync now" requests from the API still work)
SYNC_ENABLED=true
# true = every start queues a run of nvd, kev and epss right away (false: only sources that never succeeded)
SYNC_ON_START=true
NVD_CRON=7 * * * *
KEV_CRON=15 */6 * * *
EPSS_CRON=30 3 * * *
# BullMQ (Redis) — the queue shared with cti-backend
REDIS_URL=redis://localhost:6390

# Liveness/readiness HTTP port (0 disables)
HEALTH_PORT=4100
